LLM_BASE_URL=https://<gateway>/v1
LLM_API_KEY=

# Sarvam Conversations REST client (service/sarvam.py). SARVAM_APP_ID is the
# live agent (IndiaMART-S-...); SARVAM_AGENT_ID is a legacy alias still read by
# config.py and the dashboard promote path.
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=

# PUBLIC_URL is where Sarvam calls back for the 5 HTTP tools and the webhook.
PUBLIC_URL=http://localhost:8800

# Shared secret for requests arriving through the public tunnel. Tools send it as
# the x-tool-key header; Sarvam's webhook_config carries no header, so the webhook
# authenticates with ?k=<TOOL_KEY> in the URL (added automatically by start_call).
TOOL_KEY=
